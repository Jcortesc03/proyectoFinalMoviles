<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiApp1.Views"
    Title="Buscador IA"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Inicio"
            Route="InicioPage"
            ContentTemplate="{DataTemplate views:InicioPage}" />

        <ShellContent
            Title="Consultar IA"
            Route="ConsultarIaPage"
            ContentTemplate="{DataTemplate views:ConsultarIaPage}" />

        <ShellContent
            Title="Historial"
            Route="HistorialPage"
            ContentTemplate="{DataTemplate views:HistorialPage}" />

        <ShellContent
            Title="Acerca de"
            Route="AcercaDePage"
            ContentTemplate="{DataTemplate views:AcercaDePage}" />
    </TabBar>

</Shell>