<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Hallmark · redesign · theme: Riso (off-register) · genre: editorial
    paper: warm-pink light · display: risograph-bold (Archivo Black) · accent: fluoro pink + riso blue
    Tokens are declared here once; views and styles reference them by key, never by raw hex.
    OKLCH originals are noted beside each hex (MAUI XAML only accepts hex).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ===== Riso tokens · light ===== -->
    <Color x:Key="RisoPaper">#F6ECE4</Color>        <!-- oklch(94.6% 0.016 55) -->
    <Color x:Key="RisoPaper2">#EEDFD5</Color>       <!-- oklch(90.9% 0.022 50) -->
    <Color x:Key="RisoInk">#1E1B3A</Color>          <!-- oklch(24% 0.06 285)   -->
    <Color x:Key="RisoInk2">#57536E</Color>         <!-- oklch(46% 0.05 290)   -->
    <Color x:Key="RisoPink">#FF48B0</Color>         <!-- oklch(67% 0.24 350) fluoro plate, never text -->
    <Color x:Key="RisoPinkText">#B81E74</Color>     <!-- oklch(50% 0.19 350) text-safe pink -->
    <Color x:Key="RisoBlue">#0070B8</Color>         <!-- oklch(52% 0.14 245)   -->
    <Color x:Key="RisoYellow">#FFE500</Color>       <!-- oklch(91% 0.19 100)   -->
    <Color x:Key="RisoRed">#C4263A</Color>          <!-- oklch(52% 0.19 20)    -->
    <Color x:Key="RisoGreen">#00804A</Color>        <!-- oklch(52% 0.13 158)   -->
    <Color x:Key="RisoPinkSoft">#F7D6E3</Color>     <!-- oklch(89% 0.045 350) pink plate at low density -->
    <Color x:Key="RisoGhost">#E8BFCF</Color>        <!-- oklch(84% 0.05 355) dusty rose, soft off-register plate -->
    <Color x:Key="RisoEdge">#D9C7BD</Color>         <!-- oklch(83% 0.025 50) soft paper edge -->

    <!-- ===== Riso tokens · dark (night print on dark stock) ===== -->
    <Color x:Key="RisoPaperDark">#1B1828</Color>    <!-- oklch(20% 0.03 290)   -->
    <Color x:Key="RisoPaper2Dark">#262236</Color>   <!-- oklch(25% 0.035 290)  -->
    <Color x:Key="RisoInkDark">#F4E9E1</Color>      <!-- oklch(93.6% 0.016 55) -->
    <Color x:Key="RisoInk2Dark">#B9B1C4</Color>     <!-- oklch(76% 0.025 300)  -->
    <Color x:Key="RisoPinkDark">#FF5CBA</Color>     <!-- oklch(70% 0.22 350)   -->
    <Color x:Key="RisoPinkTextDark">#FF8ACD</Color> <!-- oklch(77% 0.16 350)   -->
    <Color x:Key="RisoBlueDark">#4FA9E6</Color>     <!-- oklch(70% 0.12 245)   -->
    <Color x:Key="RisoYellowDark">#FFE14D</Color>   <!-- oklch(90% 0.16 100)   -->
    <Color x:Key="RisoRedDark">#FF7A88</Color>      <!-- oklch(74% 0.15 15)    -->
    <Color x:Key="RisoGreenDark">#4FD394</Color>    <!-- oklch(79% 0.14 158)   -->
    <Color x:Key="RisoPinkSoftDark">#4A2C40</Color> <!-- oklch(33% 0.05 345)   -->
    <Color x:Key="RisoGhostDark">#5C3D55</Color>    <!-- oklch(38% 0.055 340)  -->
    <Color x:Key="RisoEdgeDark">#3A3450</Color>     <!-- oklch(33% 0.04 290)   -->

    <!-- ===== Legacy template keys, re-pointed to the Riso inks ===== -->
    <Color x:Key="Primary">#0070B8</Color>
    <Color x:Key="PrimaryDark">#4FA9E6</Color>
    <Color x:Key="PrimaryDarkText">#1B1828</Color>
    <Color x:Key="Secondary">#EEDFD5</Color>
    <Color x:Key="SecondaryDarkText">#F4E9E1</Color>
    <Color x:Key="Tertiary">#1E1B3A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#FF48B0</Color>
    <Color x:Key="MidnightBlue">#1E1B3A</Color>
    <Color x:Key="OffBlack">#1B1828</Color>

    <!-- Warm-tinted greys (paper-leaning, never zero-chroma) -->
    <Color x:Key="Gray100">#E6DAD2</Color>
    <Color x:Key="Gray200">#CFC2BB</Color>
    <Color x:Key="Gray300">#ADA2A3</Color>
    <Color x:Key="Gray400">#8E8490</Color>
    <Color x:Key="Gray500">#6C6478</Color>
    <Color x:Key="Gray600">#433E55</Color>
    <Color x:Key="Gray900">#221F33</Color>
    <Color x:Key="Gray950">#16141F</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Plate brushes for hard-offset (misregistered) shadows -->
    <SolidColorBrush x:Key="RisoPinkBrush" Color="{StaticResource RisoPink}"/>
    <SolidColorBrush x:Key="RisoPinkDarkBrush" Color="{StaticResource RisoPinkDark}"/>
    <SolidColorBrush x:Key="RisoBlueBrush" Color="{StaticResource RisoBlue}"/>
    <SolidColorBrush x:Key="RisoBlueDarkBrush" Color="{StaticResource RisoBlueDark}"/>
    <SolidColorBrush x:Key="RisoInkBrush" Color="{StaticResource RisoInk}"/>
    <SolidColorBrush x:Key="RisoInkDarkBrush" Color="{StaticResource RisoInkDark}"/>
    <SolidColorBrush x:Key="SoftShadowDarkBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>
