{
  "Database": {
    // Nombre del archivo donde se almacena la base de datos SQLite en AppDataDirectory.
    "DatabaseFileName": "mauiapp1.db3",
    // Si es true, elimina la base de datos existente al iniciar la aplicacion (util para desarrollo).
    "DeleteOnStartup": false,
    // Habilitar SQLite foreign keys (FK) para que se respeten las relaciones entre tablas.
    "EnforceForeignKeys": true
  },
  "Claude": {
    // La clave NO va aqui: definir ANTHROPIC_API_KEY (variable de entorno o Configuration/.env).
    "ApiKey": "",
    // Modelo por defecto. Se sobreescribe con CLAUDE_MODEL.
    "Model": "claude-opus-5",
    // Modelo de respaldo si el principal rechaza la consulta. Se sobreescribe con CLAUDE_FALLBACK_MODEL.
    "FallbackModel": "claude-opus-4-8",
    // Maximo de tokens de la respuesta. Se sobreescribe con CLAUDE_MAX_TOKENS.
    "MaxTokens": 16000,
    // Timeout de las llamadas HTTP, en segundos. Se sobreescribe con CLAUDE_TIMEOUT_SECONDS.
    "TimeoutSeconds": 120,
    // Instruccion de sistema enviada en cada consulta.
    "SystemInstruction": "Eres un buscador. Responde en espanol, en texto plano, sin formato Markdown."
  }
}
