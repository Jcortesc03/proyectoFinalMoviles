{
  "Database": {
    // Nombre del archivo donde se almacena la base de datos SQLite en AppDataDirectory.
    "DatabaseFileName": "mauiapp1.db3",
    // Si es true, elimina la base de datos existente al iniciar la aplicacion (util para desarrollo).
    "DeleteOnStartup": false,
    // Habilitar SQLite foreign keys (FK) para que se respeten las relaciones entre tablas.
    "EnforceForeignKeys": true
  },
  "AiApi": {
    // URL base de la API de IA externa. Reemplazar por la real.
    "BaseUrl": "https://tu-api-ia.ejemplo.com/v1",
    // Clave API. No dejar en el repositorio: usar variables de entorno o SecureStorage en produccion.
    "ApiKey": "",
    // Modelo por defecto a usar en las consultas.
    "DefaultModel": "modelo-por-defecto",
    // Timeout de las llamadas HTTP a la API, en segundos.
    "TimeoutSeconds": 60
  }
}