<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.DetallePage"
             Title="Detalle de consulta">

    <Grid RowDefinitions="Auto,*" Padding="24,24,24,0" RowSpacing="20">

        <Button Text="Volver al historial"
                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VolverCommand}"
                IsVisible="{Binding TieneDatos}"
                Style="{StaticResource RisoButtonPaper}"
                HorizontalOptions="Start" />

        <ScrollView Grid.Row="1">

            <VerticalStackLayout Spacing="16" Padding="0,0,6,32">

                <VerticalStackLayout Spacing="14"
                                     IsVisible="{Binding TieneDatos}">

                    <!-- Fecha y estado -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Fecha" Style="{StaticResource RisoLabel}" />
                            <Label Text="{Binding Fecha}" Style="{StaticResource RisoMeta}" FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Estado" Style="{StaticResource RisoLabel}" />
                            <Label Text="{Binding Estado}" Style="{StaticResource RisoEstado}" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid Margin="0,4,0,4">
                        <BoxView Style="{StaticResource RisoRuleGhost}" />
                        <BoxView Style="{StaticResource RisoRule}" />
                    </Grid>

                    <!-- Consulta: el texto del usuario, impreso grande -->
                    <Label Text="Consulta" Style="{StaticResource RisoLabel}" />
                    <Label Text="{Binding Consulta}"
                           Style="{StaticResource SubHeadline}"
                           TextTransform="None"
                           FontSize="20" />

                    <!-- Prompt enviado -->
                    <Label Text="Prompt enviado a la IA" Style="{StaticResource RisoLabel}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource RisoField}">
                        <Label Text="{Binding PromptEnviado, TargetNullValue=(No disponible)}"
                               Style="{StaticResource RisoMeta}"
                               FontSize="13"
                               LineBreakMode="WordWrap" />
                    </Border>

                    <!-- Respuesta -->
                    <Label Text="Respuesta de la IA" Style="{StaticResource RisoLabel}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource RisoCard}">
                        <Label Text="{Binding Respuesta, TargetNullValue=(Sin respuesta)}"
                               Style="{StaticResource RisoBody}" />
                    </Border>

                    <!-- Error (si existio) -->
                    <Label Text="{Binding Error}"
                           IsVisible="{Binding TieneError}"
                           Style="{StaticResource RisoError}"
                           Margin="0,8,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding NoTieneDatos}"
                                     Padding="0,48,0,0">
                    <Grid>
                        <Label Text="No hay una consulta seleccionada." Style="{StaticResource SubHeadlineGhost}" FontSize="24" />
                        <Label Text="No hay una consulta seleccionada." Style="{StaticResource SubHeadline}" FontSize="24" />
                    </Grid>
                    <Label Text="Accede a una consulta desde el historial para ver su detalle."
                           Style="{StaticResource RisoBody}"
                           TextColor="{AppThemeBinding Light={StaticResource RisoInk2}, Dark={StaticResource RisoInk2Dark}}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
