<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.AcercaDePage"
             Title="Acerca de">

    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,40" Spacing="20">

            <VerticalStackLayout Spacing="8">
                <Grid>
                    <Label Text="{Binding NombreProyecto}" Style="{StaticResource HeadlineGhost}" FontSize="40" />
                    <Label Text="{Binding NombreProyecto}" Style="{StaticResource Headline}" FontSize="40"
                           SemanticProperties.HeadingLevel="Level1" />
                </Grid>
                <Label Text="{Binding Version, StringFormat='Version {0}'}"
                       Style="{StaticResource RisoMeta}" />
            </VerticalStackLayout>

            <Label Text="{Binding Descripcion}"
                   Style="{StaticResource RisoBody}"
                   FontSize="16" />

            <Grid>
                <BoxView Style="{StaticResource RisoRuleGhost}" />
                <BoxView Style="{StaticResource RisoRule}" />
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Label Text="Tecnologias"
                       Style="{StaticResource SubHeadline}"
                       SemanticProperties.HeadingLevel="Level2" />
                <Label Text="{Binding Tecnologias}"
                       Style="{StaticResource RisoMeta}"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Border Style="{StaticResource RisoCard}" Margin="0,8,6,6">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Creadores" Style="{StaticResource RisoLabel}" />
                    <Label Text="Juan Camilo Cortes" Style="{StaticResource RisoBody}" />
                    <Label Text="Juan Camilo Ibarra" Style="{StaticResource RisoBody}" />
                    <Label Text="Isaac Moreno" Style="{StaticResource RisoBody}" />
                    <Label Text="Andruw Sarrias" Style="{StaticResource RisoBody}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
