<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.AcercaDePage"
             Title="Acerca de">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="{Binding NombreProyecto}"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="{Binding Version, StringFormat='Version {0}'}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E1E1E1, Dark=#2D2D2D}" />

            <Label Text="{Binding Descripcion}"
                   FontSize="15"
                   LineBreakMode="WordWrap" />

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E1E1E1, Dark=#2D2D2D}" />

            <Label Text="Tecnologias"
                   Style="{StaticResource SubHeadline}"
                   FontSize="20" />

            <Label Text="{Binding Tecnologias}"
                   FontSize="14"
                   LineBreakMode="WordWrap" />

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E1E1E1, Dark=#2D2D2D}" />

            <Label Text="Creadores"
                   Style="{StaticResource SubHeadline}"
                   FontSize="20" />

            <VerticalStackLayout Spacing="6">
                <Label Text="• Juan Camilo Cortes" HorizontalTextAlignment="Center" />
                <Label Text="• Juan Camilo Ibarra" HorizontalTextAlignment="Center" />
                <Label Text="• Isaac Moreno" HorizontalTextAlignment="Center" />
                <Label Text="• Andruw Sarrias" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>