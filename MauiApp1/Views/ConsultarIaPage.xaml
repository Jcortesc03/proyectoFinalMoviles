<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ConsultarIaPage"
             Title="Consultar IA">

    <VerticalStackLayout Padding="24,28,24,24" Spacing="16">

        <Grid>
            <Label Text="Consulta a la IA" Style="{StaticResource HeadlineGhost}" FontSize="32" />
            <Label Text="Consulta a la IA" Style="{StaticResource Headline}" FontSize="32"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <VerticalStackLayout Spacing="6">
            <Border Style="{StaticResource RisoField}" Padding="6,2">
                <Editor Text="{Binding Prompt}"
                        Placeholder="Escribe tu consulta aqui... (maximo 500 caracteres)"
                        MaxLength="{Binding MaxLongitudPrompt}"
                        AutoSize="TextChanges"
                        IsEnabled="{Binding PuedeConsultar}"
                        FontSize="15" />
            </Border>
            <Label Text="{Binding ContadorCaracteres}"
                   Style="{StaticResource RisoMeta}"
                   HorizontalOptions="End" />
        </VerticalStackLayout>

        <Button Text="Consultar"
                Command="{Binding ConsultarCommand}"
                IsEnabled="{Binding PuedeConsultar}" />

        <ActivityIndicator IsRunning="{Binding EstaConsultando}"
                           IsVisible="{Binding EstaConsultando}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <Label Text="{Binding MensajeError}"
               IsVisible="{Binding TieneError}"
               Style="{StaticResource RisoError}" />

        <Label Text="La respuesta de la IA aparecera aqui."
               IsVisible="{Binding MuestraAvisoSinRespuesta}"
               Style="{StaticResource RisoMeta}"
               HorizontalTextAlignment="Center"
               Margin="0,12,0,0" />

        <Border IsVisible="{Binding TieneRespuesta}"
                Style="{StaticResource RisoCard}"
                Margin="0,4,6,6">

            <ScrollView>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Respuesta de la IA" Style="{StaticResource RisoLabel}" />
                    <Label Text="{Binding Respuesta}"
                           Style="{StaticResource RisoBody}"
                           HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </VerticalStackLayout>

</ContentPage>
