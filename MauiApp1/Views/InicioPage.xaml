<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.InicioPage"
             Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,40" Spacing="24">

            <!-- Titulo impreso dos veces: placa rosa desfasada + tinta -->
            <Grid>
                <Label Text="{Binding NombreProyecto}"
                       Style="{StaticResource HeadlineGhost}"
                       FontSize="44" />
                <Label Text="{Binding NombreProyecto}"
                       Style="{StaticResource Headline}"
                       FontSize="44"
                       SemanticProperties.HeadingLevel="Level1" />
            </Grid>

            <Label Text="{Binding Proposito}"
                   Style="{StaticResource RisoBody}"
                   FontSize="16" />

            <Grid>
                <BoxView Style="{StaticResource RisoRuleGhost}" />
                <BoxView Style="{StaticResource RisoRule}" />
            </Grid>

            <VerticalStackLayout Spacing="16">
                <Label Text="Acceso rapido"
                       Style="{StaticResource SubHeadline}"
                       SemanticProperties.HeadingLevel="Level2" />

                <Button Text="Consultar IA"
                        Command="{Binding IrAConsultarCommand}"
                        Margin="0,4,0,0" />

                <Button Text="Consultar historial"
                        Style="{StaticResource RisoButtonPaper}"
                        Command="{Binding IrAHistorialCommand}" />
                <Button Text="Detalle de consulta"
                        Style="{StaticResource RisoButtonPaper}"
                        Command="{Binding IrADetalleCommand}" />
                <Button Text="Acerca de"
                        Style="{StaticResource RisoButtonPaper}"
                        Command="{Binding IrAAcercaDeCommand}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource RisoCard}" Margin="0,8,6,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Creadores" Style="{StaticResource RisoLabel}" />
                    <Label Text="Juan Camilo Cortes" Style="{StaticResource RisoBody}" />
                    <Label Text="Juan Camilo Ibarra" Style="{StaticResource RisoBody}" />
                    <Label Text="Isaac Moreno" Style="{StaticResource RisoBody}" />
                    <Label Text="Andruw Sarrias" Style="{StaticResource RisoBody}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
