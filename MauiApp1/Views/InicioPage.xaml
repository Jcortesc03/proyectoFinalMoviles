<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.InicioPage"
             Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="{Binding NombreProyecto}"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="{Binding Proposito}"
                   FontSize="15"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E1E1E1, Dark=#2D2D2D}" />

            <Label Text="Creadores"
                   Style="{StaticResource SubHeadline}"
                   FontSize="20"
                   HorizontalTextAlignment="Center" />

            <VerticalStackLayout Spacing="6">
                <Label Text="• Juan Camilo Cortes" HorizontalTextAlignment="Center" />
                <Label Text="• Juan Camilo Ibarra" HorizontalTextAlignment="Center" />
                <Label Text="• Isaac Moreno" HorizontalTextAlignment="Center" />
                <Label Text="• Andruw Sarrias" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E1E1E1, Dark=#2D2D2D}" />

            <Label Text="Acceso rapido"
                   Style="{StaticResource SubHeadline}"
                   FontSize="20"
                   HorizontalTextAlignment="Center" />

            <Button Text="Consultar IA"
                    Command="{Binding IrAConsultarCommand}" />

            <Button Text="Consultar historial"
                    Command="{Binding IrAHistorialCommand}" />

            <Button Text="Detalle de consulta"
                    Command="{Binding IrADetalleCommand}" />

            <Button Text="Acerca de"
                    Command="{Binding IrAAcercaDeCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>