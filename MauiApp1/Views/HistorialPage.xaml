<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.HistorialPage"
             Title="Consultar historial">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="24,28,24,0" RowSpacing="18">

        <Grid>
            <Label Text="Consultas guardadas" Style="{StaticResource HeadlineGhost}" FontSize="32" />
            <Label Text="Consultas guardadas" Style="{StaticResource Headline}" FontSize="32"
                   SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <!-- Filtro: hoja plana con contorno de tinta -->
        <Border Grid.Row="1" Style="{StaticResource RisoField}" Padding="14">

            <VerticalStackLayout Spacing="12">
                <Label Text="Filtrar por fecha" Style="{StaticResource RisoLabel}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Desde" Style="{StaticResource RisoMeta}" />
                        <DatePicker Date="{Binding FechaDesde}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Hasta" Style="{StaticResource RisoMeta}" />
                        <DatePicker Date="{Binding FechaHasta}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,4,4,4">
                    <Button Grid.Column="0"
                            Text="Filtrar"
                            Command="{Binding FiltrarCommand}" />
                    <Button Grid.Column="1"
                            Text="Limpiar"
                            Command="{Binding LimpiarHistorialCommand}"
                            Style="{StaticResource RisoButtonDanger}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Button Grid.Row="2"
                Text="Descargar historial (PDF)"
                Command="{Binding DescargarHistorialPdfCommand}"
                Style="{StaticResource RisoButtonYellow}"
                Margin="0,0,4,0"
                IsVisible="{Binding TieneConsultas}" />

        <Grid Grid.Row="3">

            <RefreshView IsRefreshing="{Binding EstaCargando, Mode=TwoWay}"
                         Command="{Binding CargarConsultaCommand}">

                <CollectionView ItemsSource="{Binding Consultas}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" Padding="0,40" VerticalOptions="Center">
                            <Label Text="No hay consultas para mostrar."
                                   Style="{StaticResource SubHeadline}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Cada consulta: una hoja impresa con su placa azul desfasada -->
                            <Border Margin="0,10,6,14"
                                    Style="{StaticResource RisoCard}"
                                    Padding="16,14">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                               Style="{StaticResource RisoMeta}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Estado}"
                                               Style="{StaticResource RisoEstado}" />
                                    </Grid>

                                    <Label Text="{Binding Consulta}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                    <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="0,6,0,0">
                                        <Button Text="Ver detalle"
                                                Margin="0,0,12,10"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.VerDetalleCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="PDF"
                                                Margin="0,0,12,10"
                                                Style="{StaticResource RisoButtonYellow}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.DescargarPdfCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Eliminar"
                                                Margin="0,0,12,10"
                                                Style="{StaticResource RisoButtonDanger}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.EliminarCommand}"
                                                CommandParameter="{Binding .}" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator IsRunning="{Binding EstaCargando}"
                               IsVisible="{Binding EstaCargando}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
